# Copy to .env.prod on the server (never commit .env.prod):
#   cp env.prod.example .env.prod && chmod 600 .env.prod && nano .env.prod
# Generate secrets on the server:
#   openssl rand -base64 48   (JWT_ACCESS_SECRET)
#   openssl rand -hex 24      (REVALIDATE_SECRET, POSTGRES_PASSWORD)
#   openssl rand -hex 16      (IP_HASH_SALT)

# ── Domain (no https://, no trailing slash) ─────────────
DOMAIN=datvanggroup.vn

# ── Database (container "db", only reachable inside Docker) ──
POSTGRES_PASSWORD=

# ── Auth & webhooks ──────────────────────────────────────
JWT_ACCESS_SECRET=
REVALIDATE_SECRET=
IP_HASH_SALT=
LOG_LEVEL=info

# ── Media: Cloudflare R2 ─────────────────────────────────
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dvg-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public address of the bucket: custom domain (recommended) or the r2.dev URL.
MEDIA_PUBLIC_BASE_URL=https://media.datvanggroup.vn
MAX_UPLOAD_MB=8
MAX_VIDEO_MB=100

# ── AI (Gemini) ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
I18N_DAILY_CHAR_LIMIT=400000

# ── New-lead emails (Gmail: App Password) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LEADS_NOTIFY_EMAIL=

# ── Website build ────────────────────────────────────────
NEXT_PUBLIC_COMPANY_PHONE=0911296979

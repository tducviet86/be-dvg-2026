# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (for client IP / rate limiting).
TRUST_PROXY=1

# ── Database (use a least-privilege role in production) ──
DATABASE_URL=postgresql://dvg:CHANGE_ME@localhost:5432/dvg_dev?schema=public

# ── Public origins ───────────────────────────────────────
# Frontend origin (CORS allow-list, comma separated).
APP_ORIGINS=http://localhost:3000
# Canonical public site URL (sitemap, previews).
SITE_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────
# >= 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Cookies are httpOnly; set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE=false
# Optional, e.g. .datvanggroup.vn when API and site are on sibling hosts.
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Media storage ────────────────────────────────────────
# s3 for staging/production; local is refused when NODE_ENV=production.
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=./.local/media
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
MAX_UPLOAD_MB=8
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Frontend cache revalidation webhook ──────────────────
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Shared secret, also configured in FE-DVG as REVALIDATE_SECRET.
REVALIDATE_SECRET=

# ── Privacy ──────────────────────────────────────────────
# Salt for hashing client IPs on leads (never store raw IPs).
IP_HASH_SALT=

# ── AI SEO suggestions (Gemini) ──────────────────────────
# Key from https://aistudio.google.com/apikey — server-side only, never in FE.
# Empty = the "Gợi ý SEO bằng AI" button is disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used once when the main model is overloaded (503/429).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Website translation VI → EN/KO/ZH (language switcher in the navbar).
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
# New (uncached) characters sent to Gemini per day; 0 turns translation off.
I18N_DAILY_CHAR_LIMIT=400000
